# Copy to ~/promote/config.env on the web host.
# The layout below gives each domain its web root at ~/domains/<name>/public_html.
DROP="$HOME/ci-drop"
STATE="$HOME/promote"
REPORTS_ROOT="$HOME/domains/reports.example.org/public_html"
MIRROR_ROOT="$HOME/domains/mirror.example.org/public_html"
PKG_ROOT="$HOME/domains/pkg.example.org/public_html"

# Docs sites: one "name=root" per line. A publish to <name> replaces that root's contents, so each
# root must be a domain's public_html or a folder in it, and no root may contain another.
# A site answers on every name its domain has: add the extra names as aliases of the domain.
DOCS_SITES="
guide=$HOME/domains/guide.example.org/public_html
# notes=$HOME/domains/pages.example.org/public_html/notes
"
